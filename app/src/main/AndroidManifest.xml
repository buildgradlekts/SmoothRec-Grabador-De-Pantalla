<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Requerido para el servicio en primer plano desde API 28. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Requerido desde API 34 para el tipo de servicio mediaProjection. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Permite usar el micrófono como alternativa mientras el servicio está en segundo plano. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Requerido desde API 33 para mostrar la notificación persistente. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Requerido por AudioRecord: audio interno (API 29+), micrófono o mezcla. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Consulta de GitHub Releases y descarga del APK de actualización. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ventana flotante sobre juegos y otras aplicaciones. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Mantiene la CPU despierta para que el encoder siga activo con la pantalla apagada. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Solo necesario en API 23-28; en API 29+ se usa MediaStore sin permiso. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmoothRec">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".updater.UpdateInstallActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmoothRec" />

        <service
            android:name=".capture.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />
    </application>

</manifest>
